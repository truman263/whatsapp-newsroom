NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://newsroom_user:replace_me@localhost:5432/newsroom?schema=public
# Replace deliberately with the deployment activation watermark only when Round 7 controls are authorised.
ROUND7_CONTROL_CUTOVER_AT=9999-12-31T23:59:59.999Z

WHATSAPP_ACCESS_TOKEN=replace_with_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_APP_SECRET=replace_with_app_secret
WHATSAPP_MEDIA_REQUEST_TIMEOUT_MS=5000

WORDPRESS_BASE_URL=https://example.com
WORDPRESS_DRAFT_HMAC_KEY_ID=replace_with_draft_key_id
WORDPRESS_DRAFT_HMAC_SECRET=replace_with_canonical_43_character_base64url_secret
WORDPRESS_REQUEST_TIMEOUT_MS=5000
WORDPRESS_RECONCILIATION_ATTEMPTS=3
WORDPRESS_RECONCILIATION_DELAY_MS=100
WORDPRESS_PUBLISH_HMAC_KEY_ID=replace_with_publish_key_id
WORDPRESS_PUBLISH_HMAC_SECRET=replace_with_canonical_43_character_base64url_secret

WORDPRESS_MEDIA_HMAC_KEY_ID=replace_with_media_key_id
WORDPRESS_MEDIA_HMAC_SECRET=replace_with_canonical_43_character_base64url_secret
WORDPRESS_MEDIA_REQUEST_TIMEOUT_MS=5000
WORDPRESS_MEDIA_RECONCILIATION_ATTEMPTS=3
WORDPRESS_MEDIA_RECONCILIATION_DELAY_MS=100
WORDPRESS_MEDIA_MAX_BYTES=500000
NEWSROOM_MEDIA_STAGING_MAX_BYTES=500000
